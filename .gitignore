# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dist
/packages/*/dist

# dependencies
/packages/*/node_modules
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# package manager lock files (keep pnpm-lock.yaml, ignore others)
bun.lockb
yarn.lock
package-lock.json

# local env files
.env*
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.idea/
# clerk configuration (can include secrets)
/.clerk/


# cursor 
.cursorrules
/memory-bank

# Sentry Config File
.env.sentry-build-plugin
