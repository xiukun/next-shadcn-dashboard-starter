#!/bin/sh
# Pre-push hook: 构建检查
# 过滤 baseline-browser-mapping 警告（已更新到最新版本 2.10.0，警告来自依赖链）

# 禁用 Sentry 以加快构建速度（如果未配置）
export NEXT_PUBLIC_SENTRY_DISABLED=${NEXT_PUBLIC_SENTRY_DISABLED:-"true"}

# 优化构建环境变量
export NODE_ENV=production
export NEXT_TELEMETRY_DISABLED=1

# 设置构建超时（10分钟，减少等待时间）
BUILD_TIMEOUT=600

echo "🔨 Running build check (timeout: ${BUILD_TIMEOUT}s)..."
echo "💡 Building with optimizations enabled..."

# 运行构建，使用 webpack（避免 Turbopack 可能的问题），过滤 baseline-browser-mapping 警告
# 使用 timeout 命令（如果可用）或使用后台进程 + 超时检查
if command -v gtimeout >/dev/null 2>&1; then
  # macOS 上可能需要安装 coreutils: brew install coreutils
  gtimeout ${BUILD_TIMEOUT} pnpm next build --webpack 2>&1 | grep -v "baseline-browser-mapping" | grep -v "The data in this module is over"
  BUILD_EXIT_CODE=${PIPESTATUS[0]}
elif command -v timeout >/dev/null 2>&1; then
  timeout ${BUILD_TIMEOUT} pnpm next build --webpack 2>&1 | grep -v "baseline-browser-mapping" | grep -v "The data in this module is over"
  BUILD_EXIT_CODE=${PIPESTATUS[0]}
else
  # 如果没有 timeout 命令，直接运行（macOS 默认没有 timeout）
  # 使用后台进程 + 超时检查（简单实现）
  pnpm next build --webpack 2>&1 | grep -v "baseline-browser-mapping" | grep -v "The data in this module is over" &
  BUILD_PID=$!
  
  # 等待构建完成或超时
  for i in $(seq 1 ${BUILD_TIMEOUT}); do
    if ! kill -0 $BUILD_PID 2>/dev/null; then
      wait $BUILD_PID
      BUILD_EXIT_CODE=$?
      break
    fi
    sleep 1
  done
  
  # 如果超时，杀死进程
  if kill -0 $BUILD_PID 2>/dev/null; then
    kill $BUILD_PID 2>/dev/null
    BUILD_EXIT_CODE=124
  fi
fi

# 检查构建是否成功
if [ $BUILD_EXIT_CODE -eq 124 ]; then
  echo "⏱️  Build timed out after ${BUILD_TIMEOUT}s"
  echo "💡 Tip: You can skip this check with: git push --no-verify"
  exit 1
elif [ $BUILD_EXIT_CODE -ne 0 ]; then
  echo "❌ Build failed with exit code $BUILD_EXIT_CODE"
  echo "💡 Tip: Fix the build errors or skip with: git push --no-verify"
  exit $BUILD_EXIT_CODE
else
  echo "✅ Build check passed"
fi
